{
  "name": "AIROX Midnight Glass Light",
  "type": "light",
  "colors": {
    "focusBorder": "#2b7fc480",
    "foreground": "#24324a",
    "descriptionForeground": "#5d6d86",
    "selection.background": "#2b7fc433",
    "icon.foreground": "#3c4d68",
    "widget.border": "#d5deeb",
    "textLink.foreground": "#1f6fb2",

    "titleBar.activeBackground": "#e7edf6",
    "titleBar.inactiveBackground": "#e7edf6",
    "titleBar.activeForeground": "#24324a",
    "titleBar.border": "#e7edf6",
    "commandCenter.background": "#ffffff",
    "commandCenter.border": "#d5deeb",

    "activityBar.background": "#e7edf6",
    "activityBar.foreground": "#1f6fb2",
    "activityBar.inactiveForeground": "#7a8aa3",
    "activityBar.activeBorder": "#2e9e63",
    "activityBarTop.foreground": "#1f6fb2",
    "activityBarTop.activeBorder": "#2e9e63",
    "activityBarTop.inactiveForeground": "#7a8aa3",
    "activityBarBadge.background": "#2e9e63",

    "sideBar.background": "#f4f7fb",
    "sideBar.border": "#f4f7fb",
    "sideBarTitle.foreground": "#1f6fb2",
    "sideBarSectionHeader.background": "#f4f7fb",
    "list.activeSelectionBackground": "#d6e8fa",
    "list.activeSelectionForeground": "#13233b",
    "list.inactiveSelectionBackground": "#e3edf8",
    "list.hoverBackground": "#e9f1fa",
    "list.highlightForeground": "#2e9e63",

    "editorGroupHeader.tabsBackground": "#fbfcfe",
    "editorGroup.border": "#e7edf6",
    "tab.activeBackground": "#e3eefb",
    "tab.activeForeground": "#13233b",
    "tab.inactiveBackground": "#fbfcfe",
    "tab.inactiveForeground": "#5d6d86",
    "tab.border": "#fbfcfe",
    "tab.activeBorder": "#2b7fc4",

    "editor.background": "#fbfcfe",
    "editor.foreground": "#1d2a40",
    "editorLineNumber.foreground": "#a9b8cf",
    "editorLineNumber.activeForeground": "#1f6fb2",
    "editorCursor.foreground": "#2e9e63",
    "editor.lineHighlightBackground": "#eef4fb",
    "editor.selectionBackground": "#b9d7f580",
    "editorGhostText.foreground": "#8a9ab3",
    "editorWidget.background": "#ffffff",
    "editorSuggestWidget.background": "#ffffff",

    "panel.background": "#f4f7fb",
    "panel.border": "#f4f7fb",
    "panelTitle.activeBorder": "#2e9e63",
    "terminal.background": "#f4f7fb",

    "statusBar.background": "#1f6fb2",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#1f6fb2",
    "statusBar.noFolderBackground": "#2a7f8f",

    "button.background": "#1f6fb2",
    "button.foreground": "#ffffff",
    "badge.background": "#2e9e63",
    "badge.foreground": "#ffffff",
    "input.background": "#ffffff",
    "input.border": "#d5deeb",
    "menu.background": "#ffffff",
    "menu.selectionBackground": "#d6e8fa",
    "quickInput.background": "#ffffff",
    "notifications.background": "#ffffff",
    "progressBar.background": "#2e9e63"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7a8aa3", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#8a3fc2" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#1b7f9c" } },
    { "scope": ["string"], "settings": { "foreground": "#23804f" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#b85c00" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#1f6fb2" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#9a6700" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#b03a6f", "fontStyle": "italic" } },
    { "scope": ["variable.language"], "settings": { "foreground": "#c2394a", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#c2394a" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#1f6fb2", "fontStyle": "bold" } }
  ],
  "semanticHighlighting": true
}

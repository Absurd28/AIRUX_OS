  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f7391", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#7fdba8" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#ffb86b" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#7cc4ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f2b8d4", "fontStyle": "italic" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#d5deeb" } },
    { "scope": ["variable.language", "variable.other.readwrite.instance"], "settings": { "foreground": "#ff9aa3", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff7a85" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#5fd7d7" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7cc4ff", "fontStyle": "bold" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#7fdba8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff7a85" } }
  ],
  "semanticHighlighting": true
}

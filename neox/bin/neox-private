#!/bin/bash
# NEOX Private (Tor): a throwaway NEOX window whose traffic goes through Tor, like Brave's private
# window with Tor. Tor is started only when asked for (AIRUX does not run it at boot), and the
# window's profile is deleted when it closes.
set -u
notify() { notify-send -a NEOX -i neox "NEOX Private (Tor)" "$1" 2>/dev/null || echo "$1" >&2; }
if ! systemctl is-active --quiet tor.service; then
    notify "Starting Tor…"
    systemctl start tor.service || { notify "Tor could not be started."; exit 1; }
fi
i=0
until (exec 3<>/dev/tcp/127.0.0.1/9050) 2>/dev/null; do
    i=$((i + 1)); [ "$i" -gt 60 ] && { notify "Tor did not come up on 127.0.0.1:9050."; exit 1; }
    sleep 0.5
done
# Tor accepts connections before it can carry them: on a live system it first downloads the
# network's directory (seconds, sometimes minutes). A page asked for meanwhile can hang, so the
# window opens once a request through Tor works.
i=0
until curl -sS -m 20 --socks5-hostname 127.0.0.1:9050 -o /dev/null https://check.torproject.org/api/ip 2>/dev/null; do
    [ "$i" -eq 0 ] && notify "Connecting to the Tor network…"
    i=$((i + 1)); [ "$i" -gt 24 ] && { notify "Tor could not connect to its network. Check the internet connection."; exit 1; }
    sleep 3
done
dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/neox-tor.XXXXXX")
trap 'rm -rf "$dir"' EXIT INT TERM
/usr/lib/chromium/chromium \
    --user-data-dir="$dir" \
    --class=neox-tor \
    --proxy-server="socks5://127.0.0.1:9050" \
    --host-resolver-rules="MAP * ~NOTFOUND , EXCLUDE 127.0.0.1" \
    --load-extension="$(/usr/lib/neox/user-extensions ubol)" \
    --no-first-run --no-default-browser-check --disable-pings --disable-sync --password-store=basic \
    "${1:-https://check.torproject.org/}"

#!/bin/sh
# NEOX, the AIRUX browser: Chromium's engine with NEOX's own profile, extensions (NEOX: new tab,
# AIRA side panel, Global Privacy Control, fingerprinting protection; uBlock Origin Lite: Shields)
# and privacy policies (/etc/chromium/policies/managed/neox.json).
# --password-store=basic: with KDE's wallet, Chromium pops up "KDE Wallet Service" at start and holds
# its cookie store until it is answered, so no page loads (and AIRA's commands time out) meanwhile.
export CHROME_DESKTOP=chromium.desktop
profile="${XDG_CONFIG_HOME:-$HOME/.config}/neox"
exts=$(/usr/lib/neox/user-extensions extension ubol) || exit 1
extra=""
# like Debian's chromium wrapper: use $TMPDIR when /dev/shm is small
shm=$(findmnt -bnr -o avail -T /dev/shm 2>/dev/null || echo 0)
[ "${shm:-0}" -lt 4080218931 ] && extra="--disable-dev-shm-usage"
exec /usr/lib/chromium/chromium \
    --user-data-dir="$profile" \
    --class=neox \
    --load-extension="$exts" \
    --no-default-browser-check --disable-pings --media-router=0 \
    --password-store=basic \
    $extra "$@"

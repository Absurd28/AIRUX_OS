[Unit]
Description=Phagos antivirus (real-time protection, behaviour monitoring, ransomware shield)
Documentation=file:///usr/share/doc/phagos/README
After=local-fs.target
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/sbin/phagosd
Restart=on-failure
LimitNOFILE=524288
RestartSec=2
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target

#!/bin/sh
# AIRUX 0.1 live image: Debian 13 (trixie), KDE Plasma 6 (Windows 11 layout), Calamares, AIRA.
# Areas: main, non-free-firmware (firmware for Wi-Fi, GPUs, CPUs, audio), and contrib + non-free so
# AIRUX Drivers can install NVIDIA's driver (nvidia-open-kernel-dkms is in contrib). Nothing from
# contrib that downloads at build time is installed (firmware-b43-installer and the like are not
# listed). The ISO itself stays CPU-only for the model; AIRUX Drivers installs the NVIDIA driver.
set -e
lb config noauto \
    --distribution trixie \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer none \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi,syslinux" \
    --memtest none \
    --apt-recommends false \
    --security true \
    --updates true \
    --image-name airux-0.1 \
    --iso-application "AIRUX 0.1" \
    --iso-publisher "AIRUX" \
    --iso-volume "AIRUX 0.1" \
    --bootappend-live "boot=live components quiet splash hostname=airux username=airux user-fullname=AIRUX user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,bluetooth,sudo,aira locales=en_US.UTF-8" \
    "${@}"

# --- base, live and installer
linux-image-amd64
live-boot
live-config
live-config-systemd
# creates the live user and its automatic login (only a Recommends of live-config)
user-setup
calamares
calamares-settings-debian
# Calamares needs these (only Recommends): format the EFI partition, unpack the system image
dosfstools
mtools
squashfs-tools

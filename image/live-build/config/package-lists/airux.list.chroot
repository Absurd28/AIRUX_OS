# --- base, live and installer
linux-image-amd64
live-boot
live-config
live-config-systemd
# creates the live user and its automatic login (only a Recommends of live-config)
user-setup
calamares
calamares-settings-debian
# Calamares needs these (only Recommends): format the EFI partition, unpack the system image
dosfstools
mtools
squashfs-tools
sudo
ca-certificates
curl
locales
qemu-guest-agent
spice-vdagent

# --- desktop: KDE Plasma 6, Windows 11 layout (look-and-feel package org.airux.desktop)
# Plasma's useful Recommends are listed here on purpose: the image is built without Recommends,
# and on a real laptop that silently dropped the audio, Bluetooth and drive-mount pieces.
xserver-xorg-core
xserver-xorg-input-all
xserver-xorg-video-all
x11-xserver-utils
plasma-desktop
plasma-workspace
kwin-wayland
kwin-x11
xwayland
sddm
sddm-theme-breeze
kde-config-sddm
plasma-integration
xdg-desktop-portal-kde
xdg-desktop-portal-gtk
kde-cli-tools
libkf6kcmutils-bin
kde-config-screenlocker
kde-config-gtk-style
breeze-gtk-theme
kmenuedit
kwrited
desktop-base
# the systemd user bus: PipeWire's user units need it (dbus-x11's separate bus leaves PipeWire
# stopped and the system silent)
dbus-user-session
libsecret-tools
plymouth
plymouth-themes
fonts-dejavu
fonts-noto-core
fonts-noto-color-emoji
fonts-hack
fonts-inter
fonts-jetbrains-mono
xdg-utils
xdg-user-dirs

# --- settings: Wi-Fi, Bluetooth, display, sound, power, printers, disks, app store
systemsettings
kinfocenter
network-manager
# NEOX VPN (Riseup over OpenVPN, your WireGuard, Tor's transparent proxy)
network-manager-openvpn
openvpn
wireguard-tools
nftables
tor-geoipdb
plasma-nm
plasma-pa
bluez
bluedevil
libspa-0.2-bluetooth
powerdevil
power-profiles-daemon
upower
kscreen
plasma-systemmonitor
ksystemstats
plasma-disks
print-manager
plasma-discover
udisks2

# --- apps: File Explorer (Dolphin) and the everyday tools
dolphin
dolphin-plugins
kio-extras
kio-fuse
kdegraphics-thumbnailers
ffmpegthumbs
qt6-image-formats-plugins
kimageformat6-plugins
konsole
kwrite
kcalc
kde-spectacle
ark
gwenview
okular
partitionmanager

# --- hardware: firmware the kernel's drivers load (Wi-Fi, Bluetooth, GPUs, laptop audio, cameras)
# and CPU microcode. Listed one by one: the image is built without Recommends, so before this list
# AIRUX shipped no firmware at all (no Wi-Fi, Bluetooth or microphone on a real laptop).
# Not firmware-qcom-soc: 305 MB for ARM phones and boards.
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-mediatek
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-libertas
firmware-ti-connectivity
firmware-amd-graphics
firmware-intel-graphics
firmware-nvidia-graphics
firmware-intel-sound
firmware-sof-signed
firmware-cirrus
firmware-intel-misc
bluez-firmware
intel-microcode
amd64-microcode
# memory: compressed swap in RAM (zram), so a full memory slows down instead of killing apps
# (the live system and small machines have no other swap); see /etc/systemd/zram-generator.conf
systemd-zram-generator
# graphics: Vulkan and hardware video decoding
mesa-vulkan-drivers
va-driver-all
intel-media-va-driver
# printers and scanners (driverless IPP; HP and Gutenprint drivers for older models)
cups
cups-filters
ipp-usb
printer-driver-gutenprint
hplip
sane-airscan
# devices: firmware updates from vendors (LVFS), Thunderbolt, hardware listing, Secure Boot keys,
# NVIDIA driver recommendation (used by AIRUX Drivers)
fwupd
bolt
pciutils
usbutils
mokutil
nvidia-detect

# --- offline games (KDE games: they match the desktop and need no internet). Start -> Games.
# Knights plays chess against Stockfish (listed: the image is built without Recommends).
knights
stockfish
ksudoku
kpat
kmahjongg
kmines
kreversi
kfourinline
bovo
picmi
kblocks
kbreakout
kdiamond
kbounce
knavalbattle

# --- audio: alsa-ucm-conf tells PipeWire how to drive modern laptop audio (Intel SOF speakers and
# microphones); without it a real laptop had no usable microphone
pipewire
pipewire-pulse
wireplumber
pulseaudio-utils
alsa-utils
alsa-ucm-conf

# --- AIRA's needs
chromium
wl-clipboard
xclip
libnotify-bin
poppler-utils
packagekit
polkitd

# --- developer and research toolchain
python3
python3-venv
python3-pip
jupyter-notebook
git
build-essential
podman
texlive-latex-recommended

#!/bin/sh
# AIRUX branding and defaults inside the image.
set -e

# os-release: AIRUX, based on Debian 13 (diverted, so base-files upgrades keep it)
dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<'OSR'
PRETTY_NAME="AIRUX 0.1 (based on Debian 13)"
NAME="AIRUX"
VERSION_ID="0.1"
VERSION="0.1 (with AIRA, the Adaptive Intelligent Research Assistant)"
VERSION_CODENAME=trixie
ID=airux
ID_LIKE=debian
HOME_URL="file:///usr/share/doc/aira/README.md"
OSR
ln -sf ../usr/lib/os-release /etc/os-release
echo "AIRUX 0.1 \n \l" > /etc/issue
echo "airux" > /etc/hostname

# wallpaper and login screen
update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background \
    /usr/share/backgrounds/airux/airux-wallpaper.png 100
update-alternatives --set desktop-background /usr/share/backgrounds/airux/airux-wallpaper.png

# boot splash
plymouth-set-default-theme airux
update-initramfs -u -k all

# AIRA's group exists before any user is created (the aira package also creates it)
getent group aira >/dev/null || addgroup --system aira

# installer: AIRUX branding. calamares-settings-debian's own autostart copies this launcher onto the
# live desktop only (not into /etc/skel, which would also put it on installed systems).
sed -i 's/^branding:.*/branding: airux/' /etc/calamares/settings.conf
f=/usr/share/applications/calamares-install-debian.desktop
if [ -f "$f" ]; then
    sed -i -e 's/^Name=.*/Name=Install AIRUX/' -e '/^Name\[/d' -e 's/^Icon=.*/Icon=aira/' \
        -e '/^GenericName/d' -e '/^Comment/d' "$f"
    echo "Comment=Install AIRUX with AIRA on this computer" >> "$f"
fi

# Plasma: dark from the very first login. kdeglobals only names the colour scheme; the colours
# themselves are copied in from Breeze Dark, as plasma-apply-colorscheme would.
scheme=/usr/share/color-schemes/BreezeDark.colors
if [ -f "$scheme" ]; then
    awk '/^\[/ { keep = ($0 ~ /^\[(Colors:|ColorEffects:|WM\])/) } keep' "$scheme" >> /etc/xdg/kdeglobals
fi

# Start menu pinned apps. Plasma imports Kickoff's built-in default list into its favourites
# database at first login (before any layout script can change it), so the default itself is
# changed. Diverted, so plasma-desktop upgrades keep the AIRUX list.
k=/usr/share/plasma/plasmoids/org.kde.plasma.kickoff/contents/config/main.xml
if [ -f "$k" ]; then
    dpkg-divert --quiet --local --rename --add "$k"
    sed 's|<default>preferred://browser,org.kde.kontact.desktop,systemsettings.desktop,org.kde.dolphin.desktop,org.kde.discover.desktop</default>|<default>airox-code.desktop,org.kde.dolphin.desktop,preferred://browser,org.kde.konsole.desktop,systemsettings.desktop,aira.desktop,aira-settings.desktop,org.kde.discover.desktop,org.kde.kwrite.desktop,org.kde.kcalc.desktop,org.kde.spectacle.desktop,org.kde.okular.desktop,org.kde.gwenview.desktop</default>|' \
        "$k.distrib" > "$k"
    grep -q "<default>airox-code.desktop," "$k"
fi

# Plasma's Windows 11 layout comes from the AIRUX look-and-feel package (set in /etc/xdg/kdeglobals)
test -f /usr/share/plasma/look-and-feel/org.airux.desktop/contents/layouts/org.kde.plasma.desktop-layout.js
exit 0

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AIRUX</vendor>
  <action id="org.airux.drivers.manage">
    <description>Install drivers and firmware</description>
    <message>An administrator must approve installing drivers or firmware, or switching Wi-Fi or Bluetooth on.</message>
    <icon_name>airux-drivers</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/airux-drivers/airux-drivers-helper</annotate>
  </action>
</policyconfig>

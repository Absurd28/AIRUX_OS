[Unit]
Description=AIRA speech recognition server (whisper.cpp)
After=network.target

[Service]
Type=exec
User=aira
Group=aira
ExecStart=/usr/lib/aira/aira-stt
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=AIRA login briefing (today's events, due reminders, finished or failed watched jobs)
After=graphical-session.target aira-reminderd.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/aira-reminderd --briefing

[Install]
WantedBy=graphical-session.target

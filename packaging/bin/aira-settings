#!/bin/sh
# Opens AIRA Settings (a page served by the AIRA shell), starting AIRA first if she isn't running.
f="${XDG_STATE_HOME:-$HOME/.local/state}/aira/shell.token"
ready() {
    [ -r "$f" ] || return 1
    read -r port token < "$f"
    curl -fsS -m 3 -o /dev/null -X POST -H "X-AIRA-Token: $token" -H "Content-Type: application/json" \
        -d '{"action":"get"}' "http://127.0.0.1:$port/settings"
}
if ! ready; then
    setsid aira-shell >/dev/null 2>&1 &
    i=0
    until ready; do
        i=$((i + 1))
        if [ "$i" -gt 90 ]; then
            notify-send -a AIRA "AIRA Settings" "AIRA did not start. Check 'systemctl status aira-llm'." 2>/dev/null
            exit 1
        fi
        sleep 1
    done
fi
read -r port token < "$f"
exec chromium --app="http://127.0.0.1:$port/settings" --class=aira-settings --window-size=1000,720 \
    --no-first-run --noerrdialogs --password-store=basic \
    --user-data-dir="${XDG_DATA_HOME:-$HOME/.local/share}/aira/shell-profile"
